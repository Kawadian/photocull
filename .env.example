# Standalone development. Copy to .env and adjust the root.
PHOTOCULL_LIBRARY_NAME=photos
PHOTOCULL_LIBRARY_ROOT=/mnt/PhotoLibrary
PHOTOCULL_STATE_DIR=.photocull/state
PHOTOCULL_BIND_HOST=127.0.0.1
PHOTOCULL_BIND_PORT=8000
PHOTOCULL_WORKER_MEMORY_MB=1536
PHOTOCULL_WORKER_BATCH_SIZE=8
PHOTOCULL_WORKER_PARALLELISM=1
PHOTOCULL_WORKER_STAGES=exif,preview,score
PHOTOCULL_WORKER_DEVICE=cpu
# PHOTOCULL_SCORING_MIN_SHARPNESS=0.02
# PHOTOCULL_SCORING_MIN_EXPOSURE=0.08
# PHOTOCULL_SCORING_MAX_EXPOSURE=0.92
# PHOTOCULL_SCORING_MAX_CLIPPED_HIGHLIGHTS=0.25
# PHOTOCULL_SCORING_MAX_CLIPPED_SHADOWS=0.40
# PHOTOCULL_BURST_WINDOW_SECONDS=2
# PHOTOCULL_BURST_MAX_HAMMING_DISTANCE=8
# PHOTOCULL_BURST_MIN_COSINE=0.88
# PHOTOCULL_ALLOWED_ROOTS=/mnt/PhotoLibrary
# PHOTOCULL_CONFIG=/etc/photocull/photocull.yaml
# PHOTOCULL_TOKEN_FILE=/etc/photocull/token

# Optional ML on the worker. Install photocull[ml] and use the same feature flags
# on the API. Set PHOTOCULL_WORKER_MEMORY_MB=6144 and adjust service limits.
# PHOTOCULL_MODEL_DIR=.photocull/state/models
# PHOTOCULL_ML_ENABLED=true
# PHOTOCULL_ML_SEARCH_ENABLED=true
# PHOTOCULL_ML_TAGS_ENABLED=true
# PHOTOCULL_ML_MODEL_ID=onnx-community/siglip2-base-patch16-224-ONNX
# PHOTOCULL_ML_MODEL_REVISION=ba1f3b0843f24bc5417d38e19c37b287d719b2f4
# PHOTOCULL_ML_IMAGE_SIZE=224
# PHOTOCULL_ML_OFFLINE=true
# PHOTOCULL_ML_BATCH_SIZE=4
# PHOTOCULL_ML_THREADS=2
# PHOTOCULL_ML_KEEP_TEXT_ENCODER=true
# PHOTOCULL_ML_SIMILAR_THRESHOLD=0.90
# PHOTOCULL_ML_TAG_TOP_K=3
# Add tag labels under ml.tag_vocabulary in YAML.

# Docker Compose reads these settings from .env or the shell as well.
# Configure worker.memory_mb and the ml section in the mounted YAML.
PHOTOCULL_LIBRARY_DIR=/mnt/PhotoLibrary
PHOTOCULL_STATE_HOST_DIR=./.photocull/state
PHOTOCULL_MODELS_DIR=./.photocull/models
PHOTOCULL_UID=1000
PHOTOCULL_GID=1000
# PHOTOCULL_WORKER_NETWORK_MODE=none
# PHOTOCULL_WORKER_CPUS=2.0
# PHOTOCULL_WORKER_MEM_LIMIT=2g
# PHOTOCULL_CONFIG_FILE=./deploy/photocull.example.yaml
# PHOTOCULL_NGINX_CONFIG=./deploy/systemd/nginx-photocull.conf
