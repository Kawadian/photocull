# Uncomment the settings you need and supply local values.
# PHOTOCULL_LIBRARY_NAME=
# PHOTOCULL_LIBRARY_ROOT=
# PHOTOCULL_STATE_DIR=
# PHOTOCULL_BIND_HOST=
# PHOTOCULL_BIND_PORT=
# PHOTOCULL_WORKER_MEMORY_MB=
# PHOTOCULL_WORKER_BATCH_SIZE=
# PHOTOCULL_WORKER_PARALLELISM=
# PHOTOCULL_WORKER_SCAN_PARALLELISM=
# PHOTOCULL_WORKER_SCAN_BATCH_SIZE=
# PHOTOCULL_WORKER_HASH_READ_MIB=
# PHOTOCULL_WORKER_SCAN_OVERLAP=
# PHOTOCULL_WORKER_STAGES=
# PHOTOCULL_WORKER_DEVICE=
# PHOTOCULL_SCORING_MIN_SHARPNESS=
# PHOTOCULL_SCORING_MIN_EXPOSURE=
# PHOTOCULL_SCORING_MAX_EXPOSURE=
# PHOTOCULL_SCORING_MAX_CLIPPED_HIGHLIGHTS=
# PHOTOCULL_SCORING_MAX_CLIPPED_SHADOWS=
# PHOTOCULL_BURST_WINDOW_SECONDS=
# PHOTOCULL_BURST_MAX_HAMMING_DISTANCE=
# PHOTOCULL_BURST_MIN_COSINE=
# PHOTOCULL_ALLOWED_ROOTS=
# PHOTOCULL_CONFIG=
# PHOTOCULL_TOKEN_FILE=
# Admin-only settings. Use container paths and preapprove VLM base URLs.
# PHOTOCULL_SETTINGS_ROOTS=
# PHOTOCULL_SETTINGS_ENDPOINTS=
# Enable only after installing the optional systemd restart handoff.
# PHOTOCULL_SETTINGS_RESTART_SERVICES=
# PHOTOCULL_ALLOWED_HOSTS=

# Optional ML. Use the same feature flags on the API and worker.
# PHOTOCULL_MODEL_DIR=
# PHOTOCULL_ML_ENABLED=
# PHOTOCULL_ML_SEARCH_ENABLED=
# PHOTOCULL_ML_TAGS_ENABLED=
# PHOTOCULL_ML_MODEL_ID=
# PHOTOCULL_ML_MODEL_REVISION=
# PHOTOCULL_ML_IMAGE_SIZE=
# PHOTOCULL_ML_OFFLINE=
# PHOTOCULL_ML_BATCH_SIZE=
# PHOTOCULL_ML_THREADS=
# PHOTOCULL_ML_KEEP_TEXT_ENCODER=
# PHOTOCULL_ML_SIMILAR_THRESHOLD=
# PHOTOCULL_ML_TAG_TOP_K=
# Add tag labels under ml.tag_vocabulary in YAML.

# Docker Compose reads these settings from .env or the shell as well.
# PHOTOCULL_LIBRARY_DIR=
# PHOTOCULL_STATE_HOST_DIR=
# PHOTOCULL_MODELS_DIR=
# PHOTOCULL_UID=
# PHOTOCULL_GID=
# PHOTOCULL_WORKER_NETWORK_MODE=
# PHOTOCULL_WORKER_CPUS=
# PHOTOCULL_WORKER_MEM_LIMIT=
# PHOTOCULL_CONFIG_FILE=
# PHOTOCULL_NGINX_CONFIG=
# For deploy/compose.browser.example.yml, create these dirs before starting Compose.
# PHOTOCULL_CACHE_HOT_HOST_DIR=
# PHOTOCULL_CACHE_LARGE_HOST_DIR=

# Location privacy for copy/rename and keeper exports, shared media, rendered downloads and reports.
# PHOTOCULL_BROWSER_STRIP_LOCATION=

# Browser derivatives. API and worker should use the same settings.
# PHOTOCULL_DERIVATIVES_ENABLED=
# PHOTOCULL_DERIVATIVES_HOT_DIR=
# PHOTOCULL_DERIVATIVES_LARGE_DIR=
# PHOTOCULL_DERIVATIVES_HOT_MIB=
# PHOTOCULL_DERIVATIVES_LARGE_MIB=
# PHOTOCULL_DERIVATIVES_PREWARM=
# PHOTOCULL_DERIVATIVES_AVIF_QUALITY=
# PHOTOCULL_DERIVATIVES_WEBP_QUALITY=
# PHOTOCULL_DERIVATIVES_JPEG_QUALITY=
# PHOTOCULL_DERIVATIVES_ORIGINAL_DOWNLOAD=
# PHOTOCULL_DERIVATIVES_ORIGINAL_STREAMING=
# PHOTOCULL_DERIVATIVES_ACCEL_REDIRECT=

# Optional Phase 4. Set feature flags on both API and worker.
# PHOTOCULL_BURST_AESTHETIC_WEIGHT=
# PHOTOCULL_INSIGHTS_AESTHETIC=
# PHOTOCULL_INSIGHTS_TASTE=
# PHOTOCULL_INSIGHTS_FACES=
# PHOTOCULL_INSIGHTS_STORY=
# PHOTOCULL_INSIGHTS_VIDEO=
# PHOTOCULL_INSIGHTS_TRANSCRIPT=
# PHOTOCULL_INSIGHTS_WATCH=
# PHOTOCULL_INSIGHTS_EXPORT=
# PHOTOCULL_INSIGHTS_REPORT=
# PHOTOCULL_INSIGHTS_OFFLINE=
# PHOTOCULL_INSIGHTS_THREADS=
# PHOTOCULL_INSIGHTS_FACE_REVISION=
# PHOTOCULL_INSIGHTS_FACE_THRESHOLD=
# PHOTOCULL_INSIGHTS_TASTE_MIN_PER_CLASS=
# PHOTOCULL_INSIGHTS_STORY_GAP_MINUTES=
# PHOTOCULL_INSIGHTS_STORY_DISTANCE_KM=
# PHOTOCULL_INSIGHTS_STORY_GEONAMES=
# PHOTOCULL_INSIGHTS_TRANSCRIPT_MODEL=
# PHOTOCULL_INSIGHTS_TRANSCRIPT_REVISION=
# PHOTOCULL_INSIGHTS_WATCH_MODE=
# PHOTOCULL_INSIGHTS_WATCH_INTERVAL=
# PHOTOCULL_INSIGHTS_WATCH_DEBOUNCE=
# Configure named copy destinations under insights.export_roots in YAML.
# PHOTOCULL_EXPORT_HOST_DIR=

# Phase 5. Configure per-library archive.export_roots and optional
# archive.trash_roots in the shared YAML. Default exports leave originals alone.
# See Archive → Write access or run photocull archive selftest in the worker namespace.
# PHOTOCULL_WRITE_ROOTS=
# PHOTOCULL_ARCHIVE_THREADS=
# PHOTOCULL_ARCHIVE_PARALLELISM=
# PHOTOCULL_ARCHIVE_MEMORY_MB=
# PHOTOCULL_ARCHIVE_TIMEOUT_SECONDS=
# PHOTOCULL_ARCHIVE_RETENTION_DAYS=
# PHOTOCULL_ARCHIVE_EXPORT_HOST_DIR=

# OpenAI-compatible analysis. Supply the key to the API and worker process environments.
# PHOTOCULL_VLM_BASE_URL=
# PHOTOCULL_VLM_MODEL=
# PHOTOCULL_VLM_API_KEY=

# Optional egress profile. Comma-separated HTTPS destination hostnames.
# PHOTOCULL_EGRESS_ALLOW=
