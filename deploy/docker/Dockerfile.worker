FROM ghcr.io/astral-sh/uv:0.13.10 AS uv
FROM python:3.12-slim-bookworm AS dependencies
WORKDIR /build
COPY --from=uv /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
COPY .python-version pyproject.toml uv.lock README.md LICENSE ./
COPY photocull ./photocull
RUN uv sync --locked --no-dev --no-editable --no-cache --extra worker

FROM python:3.12-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/photocull
ENV PATH="/opt/venv/bin:${PATH}" PYTHONUNBUFFERED=1
COPY --from=dependencies /opt/venv /opt/venv
USER 1000:1000
CMD ["photocull-worker"]
