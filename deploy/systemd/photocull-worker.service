[Unit]
Description=Photocull SQLite indexing worker
After=local-fs.target

[Service]
Type=simple
User=photocull
Group=photocull
WorkingDirectory=/opt/photocull
Environment=PHOTOCULL_CONFIG=/etc/photocull/photocull.yaml
Environment=XDG_CACHE_HOME=/var/cache/photocull
EnvironmentFile=-/etc/photocull/photocull.env
ExecStart=/opt/photocull/.venv/bin/photocull-worker
Restart=on-failure
RestartSec=3s
TimeoutStopSec=90s

StateDirectory=photocull
CacheDirectory=photocull
CPUQuota=200%
MemoryHigh=1700M
MemoryMax=2G
# For ML, set worker.memory_mb=6144 in shared YAML and override these
# limits in a systemd drop-in. Example: CPUQuota=600%, MemoryHigh=6G, MemoryMax=8G.
# For HDD ingest, keep worker.scan_parallelism=1 and worker.scan_overlap=false.
# Tune worker.parallelism after checking CPUQuota and the worker/child memory budgets.
# Prefetch models as the service user before running with PrivateNetwork.
# For directory exports, add ReadWritePaths=/srv/photocull-exports to the drop-in
# and set the same destination under insights.export_roots in shared YAML.
# For Archive, add ReadWritePaths for the separate archive export directory.
# For browser derivatives on HDD, set derivatives.large_dir in shared YAML
# and add ReadWritePaths for that cache root in a worker drop-in.
# For destructive Archive jobs, also add only the subtrees listed in
# PHOTOCULL_WRITE_ROOTS and any explicitly configured trash parent.
# The worker requires a passing filesystem self-test for each approved mount.
# Inspect Archive → Write access after updating mounts or permissions.
# Match per-child archive.memory_mb and archive.parallelism to MemoryMax.
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
