[Unit]
Description=Photocull web API and static UI
After=local-fs.target

[Service]
Type=simple
User=photocull
Group=photocull
WorkingDirectory=/opt/photocull
Environment=PHOTOCULL_CONFIG=/etc/photocull/photocull.yaml
EnvironmentFile=-/etc/photocull/photocull.env
ExecStart=/opt/photocull/.venv/bin/photocull-api
Restart=on-failure
RestartSec=3s

StateDirectory=photocull
MemoryMax=500M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# The optional large derivative tier is read-only to the API.
ReadOnlyPaths=-/srv/photocull-cache-hdd
# The library is read-only. Explicit XMP export can opt in via a separate drop-in.

[Install]
WantedBy=multi-user.target
